ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=   # opcional, cada proveedor tiene un default

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=MELI AI Assistant <noreply@tudominio.com>
EMAIL_ENABLED=false

# Demo
DEMO_SELLER_ID=
