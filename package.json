{
  "name": "meli-ai-assistant",
  "version": "1.0.0",
  "description": "Demo de auto-respuesta de preguntas pre-venta de Mercado Libre con LangChain.js, moderación determinística y aprobación humana.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:legacy": "node server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "client": "npm run client:dev",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "dev:full": "concurrently \"npm run dev\" \"npm run client:dev\"",
    "meli:test-users": "tsx scripts/create-test-users.ts",
    "meli:publish": "tsx scripts/publish_items_to_tenant.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@langchain/anthropic": "^0.3.11",
    "@langchain/core": "^0.3.26",
    "@langchain/groq": "^0.1.3",
    "@langchain/openai": "^0.3.16",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "resend": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
